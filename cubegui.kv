<CubeGUI>:
    solution_label: solution_label
    canvas_area: canvas_area
    solve_btn: solve_btn
    back_move_btn: back_move_btn
    next_btn: next_btn

    BoxLayout:
        orientation: 'vertical'
        spacing: 10
        padding: 10

        # ---------------------------
        # TOP NAVIGATION HEADER BAR
        # ---------------------------
        BoxLayout:
            orientation: 'horizontal'
            size_hint: (1, 0.05)

            Button:
                text: "<--"
                font_size: '24sp'
                size_hint_x: None
                width: self.height
                background_normal: ''
                background_color: (0.2, 0.2, 0.2, 1)
                on_press: root.go_back()

            Label:
                text: "3D Cube Solver Visualizer"
                font_size: '18sp'
                halign: 'left'
                valign: 'middle'
                text_size: self.size
                padding: [10, 0]

        # ---------------------------
        # FIXED WRAPPING SOLUTION LABEL
        # ---------------------------
        Label:
            id: solution_label
            text: "Solution: "
            size_hint: (1, 0.17)
            font_size: '16sp'
            text_size: (self.width - 20, None)
            halign: 'center'
            valign: 'middle'

        # ---------------------------
        # VISUALIZER CANVAS WORKSPACE
        # ---------------------------
        Widget:
            id: canvas_area
            size_hint: (0.75, 0.35)
            pos_hint: {"center_x": 0.5, "center_y": 0.5}
            on_pos: root.draw_cube()
            on_size: root.draw_cube()

        # ---------------------------
        # BOTTOM CONTROLS BAR
        # ---------------------------
        BoxLayout:
            orientation: 'horizontal'
            size_hint: (1, 0.1)
            pos_hint: {"center_x": 0.5, "center_y": 0.5}
            spacing: 10

            Button:
                id: back_move_btn
                text: "Back Move"
                disabled: True       # Starts disabled
                on_press: root.back_move()

            Button:
                id: solve_btn
                text: "Solve"
                disabled: False
                on_press: root.solve_cube()

            Button:
                id: next_btn
                text: "Next Move"
                disabled: True       # Starts disabled
                on_press: root.next_move()