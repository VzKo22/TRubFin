<MenuScreen>:
    canvas.before:
        Color:
            rgba: 0.05, 0.08, 0.15, 1
        Rectangle:
            pos: self.pos
            size: self.size

    FloatLayout:

        # Title
        Label:
            text: "Rubik's Cube Solver"
            font_size: '28sp'
            bold: True
            color: (0.4, 0.75, 1, 1)
            size_hint: (1, 0.12)
            pos_hint: {"center_x": 0.5, "top": 0.88}
            halign: 'center'
            valign: 'middle'
            text_size: self.size

        Label:
            text: "Choose an input method"
            font_size: '14sp'
            color: (0.55, 0.65, 0.78, 1)
            size_hint: (1, 0.06)
            pos_hint: {"center_x": 0.5, "top": 0.76}
            halign: 'center'
            valign: 'middle'
            text_size: self.size

        BoxLayout:
            orientation: 'vertical'
            size_hint: (0.7, 0.22)
            pos_hint: {"center_x": 0.5, "center_y": 0.5}
            spacing: 16

            Button:
                text: "Manual Input"
                font_size: '16sp'
                bold: True
                background_normal: ''
                background_color: (0, 0, 0, 0)
                color: (1, 1, 1, 1)
                on_press: root.open_manual()
                canvas.before:
                    Color:
                        rgba: (0.13, 0.42, 0.82, 1)
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [22]

            Button:
                text: "Scanner"
                font_size: '16sp'
                bold: True
                background_normal: ''
                background_color: (0, 0, 0, 0)
                color: (0.4, 0.75, 1, 1)
                on_press: root.open_scanner()
                canvas.before:
                    Color:
                        rgba: (0.13, 0.42, 0.82, 0.2)
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [22]
                    Color:
                        rgba: (0.13, 0.42, 0.82, 0.8)
                    Line:
                        rounded_rectangle: [self.x, self.y, self.width, self.height, 22]
                        width: 1.2
